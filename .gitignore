*.log
*.pid
*.pid.lock
*.seed
*.out

# Environment variables and local secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Package-manager and installer caches
.cache/
pip-log.txt

# BasicSR/PSUID experiment outputs
experiments/
results/
outputs/
tb_logger/
wandb/
runs/
checkpoints/
pretrained_models/
visualization/

